        let activeGainNode = null;

        function initAudioContext() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function playWeatherSynth(iconType) {
            initAudioContext();
            stopWeatherSynth();
            if (!isWeatherSoundPlaying) return;

            const bufferSize = audioCtx.sampleRate * 2;
            const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
            const output = buffer.getChannelData(0);

            let b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;
            for (let i = 0; i < bufferSize; i++) {
                let white = Math.random() * 2 - 1;
                b0 = 0.99886 * b0 + white * 0.0555179;
                b1 = 0.99332 * b1 + white * 0.0750759;
                b2 = 0.96900 * b2 + white * 0.1538520;
                b3 = 0.86650 * b3 + white * 0.3104856;
                b4 = 0.55000 * b4 + white * 0.5329522;
                b5 = -0.7616 * b5 - white * 0.0168980;
                output[i] = b0 + b1 + b2 + b3 + b4 + b5 + b6 + white * 0.5362;
                output[i] *= 0.11; 
                b6 = white * 0.115926;
            }

            let whiteNoise = audioCtx.createBufferSource();
            whiteNoise.buffer = buffer;
            whiteNoise.loop = true;

            let filter = audioCtx.createBiquadFilter();
            activeGainNode = audioCtx.createGain();

            if (iconType === 'rain' || iconType === 'thunder') {
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(800, audioCtx.currentTime);
                activeGainNode.gain.setValueAtTime(0.15, audioCtx.currentTime);
                document.getElementById('currentSoundType').innerText = 'Bunyi Hujan Sintetik';
            } else {
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(400, audioCtx.currentTime);
                activeGainNode.gain.setValueAtTime(0.08, audioCtx.currentTime);
                document.getElementById('currentSoundType').innerText = 'Bunyi Suasana Berawan';
            }

            whiteNoise.connect(filter);
            filter.connect(activeGainNode);
            activeGainNode.connect(audioCtx.destination);

            whiteNoise.start();
            activeNoiseNode = whiteNoise;
        }

        function stopWeatherSynth() {
            if (activeNoiseNode) {
                try {
                    activeNoiseNode.stop();
                    activeNoiseNode.disconnect();
                } catch (e) {}
                activeNoiseNode = null;
            }
        }


        function renderCalendar() {
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();
            const monthNamesMalay = ['Januari', 'Februari', 'Mac', 'April', 'Mei', 'Jun', 'Julai', 'Ogos', 'September', 'Oktober', 'November', 'Disember'];

            document.getElementById('calendarMonthYear').innerText = `${monthNamesMalay[month]} ${year}`;

            const firstDayIndex = new Date(year, month, 1).getDay();
            const lastDay = new Date(year, month + 1, 0).getDate();
            const prevLastDay = new Date(year, month, 0).getDate();

            const grid = document.getElementById('calendarGrid');
            grid.innerHTML = '';

            for (let i = firstDayIndex; i > 0; i--) {
                const dayNum = prevLastDay - i + 1;
                const div = document.createElement('div');
                div.className = 'min-h-[85px] p-2 rounded-2xl bg-slate-900/30 border border-slate-800/40 text-slate-600 text-xs font-medium';
                div.innerText = dayNum;
                grid.appendChild(div);
            }

            const todayStr = formatDate(new Date());

            for (let day = 1; day <= lastDay; day++) {
                const dateObj = new Date(year, month, day);
                const dateStr = formatDate(dateObj);
                const dayOfWeek = dateObj.getDay();

                const holiday = publicHolidays2026.find(h => h.date === dateStr);
                const schoolHol = schoolHolidays2026.find(s => dateStr >= s.start && dateStr <= s.end);
                const hasNote = personalNotes[dateStr];

                const dayCard = document.createElement('div');
                let cardStyle = 'min-h-[85px] p-2 rounded-2xl border transition calendar-day-hover flex flex-col justify-between cursor-pointer ';

                if (dateStr === todayStr) {
                    cardStyle += 'bg-blue-900/50 border-blue-400 ring-2 ring-blue-400/50 ';
                } else if (holiday) {
                    cardStyle += 'bg-rose-950/40 border-rose-600/60 ';
                } else if (schoolHol) {
                    cardStyle += 'bg-amber-950/30 border-amber-500/50 ';
                } else {
                    cardStyle += 'bg-slate-800/50 border-slate-700/60 hover:bg-slate-800 ';
                }

                dayCard.className = cardStyle;
                dayCard.onclick = () => openDayModal(dateStr, holiday, schoolHol);

                let numClass = 'font-bold text-sm ';
                if (dayOfWeek === 0) numClass += 'text-rose-400';
                else if (dayOfWeek === 6) numClass += 'text-amber-400';
                else numClass += 'text-slate-200';

                let innerHTML = `<div class="flex justify-between items-center">
                    <span class="${numClass}">${day}</span>
                    <div class="flex items-center gap-1">
                        ${hasNote ? '<span class="w-2 h-2 rounded-full bg-blue-400" title="Ada Nota"></span>' : ''}
                        ${dateStr === todayStr ? '<span class="text-[9px] bg-blue-500 text-white font-extrabold px-1.5 py-0.5 rounded-md">HARI INI</span>' : ''}
                    </div>
                </div>`;

                innerHTML += '<div class="mt-1 space-y-1">';
                if (holiday) {
                    innerHTML += `<div class="bg-rose-600/80 text-white text-[10px] font-semibold p-1 rounded-lg truncate"><i class="fa-solid fa-star mr-1 text-[8px]"></i>${holiday.title}</div>`;
                }
                if (schoolHol) {
                    innerHTML += `<div class="bg-amber-600/70 text-white text-[9px] font-semibold px-1 py-0.5 rounded-lg truncate"><i class="fa-solid fa-graduation-cap mr-1 text-[8px]"></i>Cuti Sekolah</div>`;
                }
                if (hasNote) {
                    innerHTML += `<div class="bg-blue-600/70 text-white text-[9px] font-semibold px-1 py-0.5 rounded-lg truncate"><i class="fa-solid fa-note-sticky mr-1 text-[8px]"></i>${hasNote}</div>`;
                }
                innerHTML += '</div>';

                dayCard.innerHTML = innerHTML;
                grid.appendChild(dayCard);
            }

            renderMonthHolidaysList(month);
            renderSchoolHolidaysList();
        }

        function renderMonthHolidaysList(monthIndex) {
            const listEl = document.getElementById('publicHolidaysList');
            const badgeEl = document.getElementById('holidayCountBadge');
            listEl.innerHTML = '';

            const filtered = publicHolidays2026.filter(h => new Date(h.date).getMonth() === monthIndex);
            badgeEl.innerText = `${filtered.length} Cuti`;

            if (filtered.length === 0) {
                listEl.innerHTML = '<li class="text-slate-500 text-xs italic py-2">Tiada cuti umum pada bulan ini.</li>';
                return;
            }

            filtered.forEach(h => {
                const dateFormatted = new Date(h.date).toLocaleDateString('ms-MY', { day: 'numeric', month: 'long', year: 'numeric' });
                const li = document.createElement('li');
                li.className = 'bg-slate-800/80 p-3 rounded-2xl border border-rose-500/25 flex items-center justify-between cursor-pointer hover:border-rose-500/50 transition';
                li.onclick = () => openDayModal(h.date, h, null);
                li.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <div class="w-2.5 h-2.5 rounded-full bg-rose-500"></div>
                        <div>
                            <p class="font-bold text-slate-100">${h.title}</p>
                            <p class="text-xs text-rose-300/80">${dateFormatted}</p>
                        </div>
                    </div>
                    <i class="fa-solid fa-chevron-right text-xs text-slate-500"></i>
                `;
                listEl.appendChild(li);
            });
        }

        function renderSchoolHolidaysList() {
            const listEl = document.getElementById('schoolHolidaysList');
            listEl.innerHTML = '';

            schoolHolidays2026.forEach(s => {
                const startDate = new Date(s.start).toLocaleDateString('ms-MY', { day: 'numeric', month: 'short' });
                const endDate = new Date(s.end).toLocaleDateString('ms-MY', { day: 'numeric', month: 'short', year: 'numeric' });
                const li = document.createElement('li');
                li.className = 'bg-slate-800/80 p-3 rounded-2xl border border-amber-500/25 flex items-center justify-between';
                li.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <div class="p-2 rounded-xl bg-amber-500/20 text-amber-400 text-xs"><i class="fa-solid fa-umbrella-beach"></i></div>
                        <div>
                            <p class="font-bold text-slate-100 text-xs">${s.title}</p>
                            <p class="text-[11px] text-amber-300">${startDate} - ${endDate}</p>
                        </div>
                    </div>
                `;
                listEl.appendChild(li);
            });
        }

        function changeMonth(offset) {
            currentDate.setMonth(currentDate.getMonth() + offset);
            renderCalendar();
        }

        function goToToday() {
            currentDate = new Date();
            currentDate.setFullYear(2026);
            renderCalendar();
        }

        function openDayModal(dateStr, holiday, schoolHol) {
            selectedDateStr = dateStr;
            const modal = document.getElementById('eventModal');
            document.getElementById('modalDate').innerText = new Date(dateStr).toLocaleDateString('ms-MY', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
            
            const modalTitle = document.getElementById('modalTitle');
            const modalContent = document.getElementById('modalContent');
            const modalIcon = document.getElementById('modalIcon');
            const noteInput = document.getElementById('personalNoteInput');
            const noteDisplay = document.getElementById('savedNoteDisplay');

            noteInput.value = personalNotes[dateStr] || '';
            noteDisplay.innerText = personalNotes[dateStr] ? `Nota Disimpan: ${personalNotes[dateStr]}` : '';

            if (holiday) {
                modalTitle.innerText = holiday.title;
                modalIcon.className = 'p-3 rounded-2xl bg-rose-500/20 text-rose-400 text-xl';
                modalIcon.innerHTML = '<i class="fa-solid fa-gift"></i>';
                modalContent.innerHTML = `<p class="font-semibold text-rose-300">Cuti Umum / Perayaan</p><p>${holiday.desc}</p>`;
            } else if (schoolHol) {
                modalTitle.innerText = schoolHol.title;
                modalIcon.className = 'p-3 rounded-2xl bg-amber-500/20 text-amber-400 text-xl';
                modalIcon.innerHTML = '<i class="fa-solid fa-graduation-cap"></i>';
                modalContent.innerHTML = `<p class="font-semibold text-amber-300">Cuti Penggal Sekolah KPM</p><p>${schoolHol.desc}</p>`;
            } else {
                modalTitle.innerText = 'Hari Biasa';
                modalIcon.className = 'p-3 rounded-2xl bg-blue-500/20 text-blue-400 text-xl';
                modalIcon.innerHTML = '<i class="fa-solid fa-calendar-day"></i>';
                modalContent.innerHTML = `<p>Tiada cuti umum atau cuti sekolah rasmi pada tarikh ini.</p>`;
            }

            modal.classList.remove('hidden');
        }

        function savePersonalNote() {
            const val = document.getElementById('personalNoteInput').value.trim();
            if (val) {
                personalNotes[selectedDateStr] = val;
            } else {
                delete personalNotes[selectedDateStr];
            }
            localStorage.setItem('malaysia_cal_notes_2026', JSON.stringify(personalNotes));
            document.getElementById('savedNoteDisplay').innerText = val ? `Nota Disimpan: ${val}` : '';
            renderCalendar();
        }

        function closeModal() {
            document.getElementById('eventModal').classList.add('hidden');
        }

        function toggleWidgetPreviewModal() {
            const modal = document.getElementById('widgetModal');
            modal.classList.toggle('hidden');
        }
    </script>
</body>
</html>


<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalendar & Cuaca Malaysia 2026</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: '#0284c7',
                        holiday: '#e11d48',
                        school: '#d97706',
                    },
                    animation: {
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'bounce-gentle': 'bounce 2s infinite',
                        'float': 'float 4s ease-in-out infinite',
                        'sun-spin': 'spin 20s linear infinite',
                        'cloud-drift': 'cloudDrift 25s linear infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-8px)' },
                        },
                        cloudDrift: {
                            '0%': { transform: 'translateX(-20px)' },
                            '50%': { transform: 'translateX(20px)' },
                            '100%': { transform: 'translateX(-20px)' },
                        }
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #f8fafc;
            min-height: 100vh;
        }

        .weather-card-bg {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            position: relative;
            overflow: hidden;
        }

        .glass-panel {
            background: rgba(30, 41, 59, 0.75);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .calendar-day-hover {
            transition: all 0.2s ease-in-out;
        }

        .calendar-day-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #1e293b;
        }
        ::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 4px;
        }
    </style>
</head>
<body class="antialiased min-h-screen flex flex-col pb-10">

    <header class="glass-panel sticky top-0 z-40 border-b border-slate-700/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <div class="bg-gradient-to-tr from-amber-500 to-red-600 p-3 rounded-2xl shadow-lg shadow-amber-500/20 text-white">
                        <i class="fa-solid fa-calendar-days text-2xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl font-extrabold tracking-tight text-white flex items-center gap-2">
                            Kalendar Malaysia <span class="text-xs px-2.5 py-0.5 rounded-full bg-red-600/80 text-white font-medium">2026</span>
                        </h1>
                        <p class="text-xs text-slate-400">Cuti Perayaan • Cuti Sekolah KPM • Waktu Solat • Cuaca</p>
                    </div>
                </div>

                <div class="flex items-center bg-slate-800/80 p-1.5 rounded-xl border border-slate-700">
                    <div class="px-3 text-red-500 animate-bounce-gentle">
                        <i class="fa-solid fa-location-dot text-lg"></i>
                    </div>
                    <select id="stateSelect" onchange="changeState()" class="bg-transparent text-sm font-semibold text-slate-200 pr-8 py-1.5 focus:outline-none cursor-pointer">
                        <option value="Kuala Lumpur" selected class="bg-slate-800 text-white">Kuala Lumpur / Putrajaya</option>
                        <option value="Selangor" class="bg-slate-800 text-white">Selangor</option>
                        <option value="Johor" class="bg-slate-800 text-white">Johor</option>
                        <option value="Penang" class="bg-slate-800 text-white">Pulau Pinang</option>
                        <option value="Perak" class="bg-slate-800 text-white">Perak</option>
                        <option value="Kedah" class="bg-slate-800 text-white">Kedah</option>
                        <option value="Kelantan" class="bg-slate-800 text-white">Kelantan</option>
                        <option value="Terengganu" class="bg-slate-800 text-white">Terengganu</option>
                        <option value="Pahang" class="bg-slate-800 text-white">Pahang</option>
                        <option value="Melaka" class="bg-slate-800 text-white">Melaka</option>
                        <option value="Negeri Sembilan" class="bg-slate-800 text-white">Negeri Sembilan</option>
                        <option value="Sabah" class="bg-slate-800 text-white">Sabah</option>
                        <option value="Sarawak" class="bg-slate-800 text-white">Sarawak</option>
                    </select>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full space-y-6">

        <section class="glass-panel rounded-2xl p-4 border border-slate-700/80 flex flex-col md:flex-row items-center justify-between gap-4 bg-slate-900/80">
            <div class="flex items-center space-x-3 w-full md:w-auto">
                <button id="toggleWeatherSoundBtn" onclick="toggleWeatherSound()" class="px-4 py-2 bg-blue-600/80 hover:bg-blue-500 text-white text-xs font-bold rounded-xl transition flex items-center gap-2 shadow-lg shadow-blue-500/20 active:scale-95">
                    <i id="weatherSoundIcon" class="fa-solid fa-volume-high text-sm"></i>
                    <span id="weatherSoundText">Mainkan Bunyi Cuaca</span>
                </button>
                <div class="text-xs text-slate-400 hidden sm:block">
                    <span class="text-blue-300 font-semibold" id="currentSoundType">Sintesis Bunyi Cuaca</span>
                </div>
            </div>

            <div class="flex items-center justify-between md:justify-end gap-3 w-full md:w-auto bg-slate-800/80 p-2.5 rounded-xl border border-slate-700/60">
                <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-lg bg-gradient-to-tr from-pink-500 to-rose-500 flex items-center justify-center text-white shadow-md">
                        <i class="fa-solid fa-music text-sm" id="musicDiscIcon"></i>
                    </div>
                    <div class="max-w-[130px] sm:max-w-[180px] truncate">
                        <p class="text-xs font-bold text-white truncate" id="songTitleDisplay">Pop Vibe - Energy Beat</p>
                        <p class="text-[10px] text-pink-300">Lagu Pop Santai</p>
                    </div>
                </div>

                <div class="flex items-center space-x-2">
                    <button onclick="toggleMusic()" class="w-8 h-8 rounded-lg bg-pink-600 hover:bg-pink-500 text-white flex items-center justify-center transition active:scale-95 shadow-md shadow-pink-600/30">
                        <i id="playMusicIcon" class="fa-solid fa-play text-xs"></i>
                    </button>
                    <div class="flex items-end space-x-0.5 h-5 px-1 bg-slate-900/50 rounded p-1">
                        <span class="w-1 bg-pink-500 rounded-full h-2 animate-pulse"></span>
                        <span class="w-1 bg-pink-400 rounded-full h-4 animate-bounce" style="animation-delay: 0.1s"></span>
                        <span class="w-1 bg-pink-500 rounded-full h-3 animate-pulse" style="animation-delay: 0.2s"></span>
                    </div>
                </div>

                <audio id="popMusicAudio" loop preload="auto">
                    <source src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=pop-summer-party-115291.mp3" type="audio/mpeg">
                </audio>
            </div>
        </section>

        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <div class="lg:col-span-2 weather-card-bg rounded-3xl p-6 shadow-2xl border border-blue-400/30 flex flex-col justify-between relative">
                <div id="weatherSvgContainer" class="absolute inset-0 pointer-events-none opacity-40"></div>

                <div class="relative z-10 flex flex-wrap justify-between items-start gap-4">
                    <div>
                        <div class="flex items-center space-x-2 text-blue-100 text-xs font-bold uppercase tracking-wider bg-black/20 px-3 py-1 rounded-full w-fit">
                            <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span>Laporan Cuaca Terkini</span>
                        </div>
                        <h2 id="weatherLocation" class="text-3xl font-extrabold text-white mt-2">Kuala Lumpur</h2>
                        <p id="weatherDesc" class="text-blue-100 text-sm mt-1 font-medium">Hujan Ribut / Berawan</p>
                    </div>

                    <div class="text-right">
                        <div class="flex items-baseline justify-end">
                            <span id="tempDisplay" class="text-6xl font-black text-white tracking-tighter">31</span>
                            <span class="text-3xl font-light text-blue-200">°C</span>
                        </div>
                        <p id="feelsLike" class="text-xs text-blue-200">Rasa seperti 34°C</p>
                    </div>
                </div>

                <div class="relative z-10 grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 pt-6 border-t border-white/10 text-white">
                    <div class="bg-black/20 backdrop-blur-md p-3 rounded-2xl flex items-center space-x-3">
                        <div class="text-blue-300 text-xl"><i class="fa-solid fa-droplet"></i></div>
                        <div>
                            <p class="text-[10px] text-blue-200 uppercase font-semibold">Kelembapan</p>
                            <p id="humidityDisplay" class="text-sm font-bold">82%</p>
                        </div>
                    </div>
                    <div class="bg-black/20 backdrop-blur-md p-3 rounded-2xl flex items-center space-x-3">
                        <div class="text-teal-300 text-xl"><i class="fa-solid fa-wind"></i></div>
                        <div>
                            <p class="text-[10px] text-blue-200 uppercase font-semibold">Angin</p>
                            <p id="windDisplay" class="text-sm font-bold">14 km/h</p>
                        </div>
                    </div>
                    <div class="bg-black/20 backdrop-blur-md p-3 rounded-2xl flex items-center space-x-3">
                        <div class="text-amber-300 text-xl"><i class="fa-solid fa-cloud-sun-rain"></i></div>
                        <div>
                            <p class="text-[10px] text-blue-200 uppercase font-semibold">Hujan</p>
                            <p id="rainChanceDisplay" class="text-sm font-bold">75%</p>
                        </div>
                    </div>
                    <div class="bg-black/20 backdrop-blur-md p-3 rounded-2xl flex items-center space-x-3">
                        <div class="text-indigo-300 text-xl"><i class="fa-solid fa-eye"></i></div>
                        <div>
                            <p class="text-[10px] text-blue-200 uppercase font-semibold">Penglihatan</p>
                            <p id="visibilityDisplay" class="text-sm font-bold">9 km</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="glass-panel rounded-3xl p-6 flex flex-col justify-between border border-slate-700/80">
                <div class="flex items-center justify-between">
                    <h3 class="text-base font-bold text-slate-200 flex items-center gap-2">
                        <i class="fa-solid fa-mosque text-emerald-400"></i>
                        Waktu Solat Malaysia
                    </h3>
                    <span class="bg-emerald-500/20 text-emerald-300 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-500/30">JAKIM</span>
                </div>

                <div class="grid grid-cols-2 gap-2 my-3 text-xs">
                    <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700/50 flex justify-between items-center">
                        <span class="text-slate-400 font-medium">Imsak</span>
                        <span id="solatImsak" class="font-bold text-slate-200">05:42</span>
                    </div>
                    <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700/50 flex justify-between items-center">
                        <span class="text-slate-400 font-medium">Subuh</span>
                        <span id="solatSubuh" class="font-bold text-emerald-400">05:52</span>
                    </div>
                    <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700/50 flex justify-between items-center">
                        <span class="text-slate-400 font-medium">Zohor</span>
                        <span id="solatZohor" class="font-bold text-slate-200">13:20</span>
                    </div>
                    <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700/50 flex justify-between items-center">
                        <span class="text-slate-400 font-medium">Asar</span>
                        <span id="solatAsar" class="font-bold text-slate-200">16:42</span>
                    </div>
                    <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700/50 flex justify-between items-center">
                        <span class="text-slate-400 font-medium">Maghrib</span>
                        <span id="solatMaghrib" class="font-bold text-amber-400">19:30</span>
                    </div>
                    <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700/50 flex justify-between items-center">
                        <span class="text-slate-400 font-medium">Isyak</span>
                        <span id="solatIsyak" class="font-bold text-slate-200">20:43</span>
                    </div>
                </div>

                <div class="space-y-1.5 bg-slate-800/50 p-3 rounded-xl border border-slate-700/40 text-xs">
                    <div class="flex justify-between items-center">
                        <span class="text-slate-400">Status Sekolah:</span>
                        <span id="schoolStatusToday" class="font-bold text-emerald-400">Hari Persekolahan</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-400">Kumpulan Cuti:</span>
                        <span id="kumpulanState" class="font-bold text-slate-200 text-[11px]">Kumpulan B</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="glass-panel rounded-3xl p-6 shadow-2xl">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-6 border-b border-slate-700/60">
                <div class="flex items-center space-x-4">
                    <button onclick="changeMonth(-1)" class="w-10 h-10 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 flex items-center justify-center transition border border-slate-700 active:scale-95">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <h2 id="calendarMonthYear" class="text-2xl font-extrabold text-white tracking-wide min-w-[220px] text-center">
                        Januari 2026
                    </h2>
                    <button onclick="changeMonth(1)" class="w-10 h-10 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 flex items-center justify-center transition border border-slate-700 active:scale-95">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>

                <div class="flex flex-wrap items-center gap-3 text-xs font-semibold">
                    <div class="flex items-center space-x-1.5 bg-rose-500/10 border border-rose-500/30 text-rose-400 px-3 py-1.5 rounded-xl">
                        <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                        <span>Cuti Umum</span>
                    </div>
                    <div class="flex items-center space-x-1.5 bg-amber-500/10 border border-amber-500/30 text-amber-400 px-3 py-1.5 rounded-xl">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                        <span>Cuti Sekolah</span>
                    </div>
                    <button onclick="goToToday()" class="bg-blue-600 hover:bg-blue-500 text-white px-3.5 py-1.5 rounded-xl transition shadow-md shadow-blue-600/30">
                        Hari Ini
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-7 text-center text-xs font-bold text-slate-400 my-4 uppercase tracking-wider">
                <div class="text-rose-400">Ahad</div>
                <div>Isnin</div>
                <div>Selasa</div>
                <div>Rabu</div>
                <div>Khamis</div>
                <div>Jumaat</div>
                <div class="text-amber-400">Sabtu</div>
            </div>

            <div id="calendarGrid" class="grid grid-cols-7 gap-2"></div>
        </section>

        <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="glass-panel rounded-3xl p-6 border border-slate-700/80 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold text-rose-400 flex items-center gap-2">
                            <i class="fa-solid fa-gift"></i>
                            Cuti Umum Bulan Ini
                        </h3>
                        <span id="holidayCountBadge" class="bg-rose-500/20 text-rose-300 text-xs font-bold px-2.5 py-1 rounded-full border border-rose-500/30">0 Cuti</span>
                    </div>
                    <ul id="publicHolidaysList" class="space-y-2.5 text-sm"></ul>
                </div>
            </div>

            <div class="glass-panel rounded-3xl p-6 border border-slate-700/80 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold text-amber-400 flex items-center gap-2">
                            <i class="fa-solid fa-graduation-cap"></i>
                            Takwim Cuti Sekolah KPM 2026
                        </h3>
                        <span class="bg-amber-500/20 text-amber-300 text-xs font-bold px-2.5 py-1 rounded-full border border-amber-500/30">Semua Penggal</span>
                    </div>
                    <ul id="schoolHolidaysList" class="space-y-2.5 text-sm"></ul>
                </div>
            </div>
        </section>

        <section class="glass-panel rounded-3xl p-6 border border-slate-700/80 shadow-2xl space-y-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-700/60 pb-4">
                <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/30">
                        <i class="fa-solid fa-mobile-screen-button mr-1.5"></i>Panduan Telefon & Widget
                    </span>
                    <h2 class="text-xl font-extrabold text-white mt-2">Bolehkah App Ini Dijadikan Widget Di Telefon?</h2>
                    <p class="text-xs text-slate-400 mt-1">Ya! Anda boleh memasang laman ini sebagai **Progressive Web App (PWA)** atau Widget Skrin Utama.</p>
                </div>
                <button onclick="toggleWidgetPreviewModal()" class="px-4 py-2.5 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-emerald-500/20 transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-eye"></i>
                    Lihat Simulasi Widget Skrin Utama
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-slate-300">
                <!-- Android Guide -->
                <div class="bg-slate-800/60 p-5 rounded-2xl border border-slate-700/70 space-y-3">
                    <div class="flex items-center space-x-3 text-emerald-400">
                        <i class="fa-brands fa-android text-2xl"></i>
                        <h3 class="text-sm font-bold text-white">Panduan Android (Google Chrome)</h3>
                    </div>
                    <ol class="list-decimal list-inside space-y-2 text-slate-300">
                        <li>Buka aplikasi ini menggunakan **Google Chrome** di telefon anda.</li>
                        <li>Tekan ikon <strong>3 Titik (Menu)</strong> di sudut atas kanan Chrome.</li>
                        <li>Pilih <strong>"Add to Home screen"</strong> atau <strong>"Install app"</strong>.</li>
                        <li>Tekan **Add / Tambah**. Ikon aplikasi akan muncul di Skrin Utama telefon anda!</li>
                    </ol>
                    <div class="bg-emerald-950/40 border border-emerald-500/30 p-2.5 rounded-xl text-emerald-300 font-medium">
                        💡 <em>Tip Widget:</em> Pelayar pintar Android membolehkan anda letak *Web Shortcut/PWA Tile* seperti Widget untuk akses pantas waktu solat & cuaca!
                    </div>
                </div>

                <!-- iOS Guide -->
                <div class="bg-slate-800/60 p-5 rounded-2xl border border-slate-700/70 space-y-3">
                    <div class="flex items-center space-x-3 text-sky-400">
                        <i class="fa-brands fa-apple text-2xl"></i>
                        <h3 class="text-sm font-bold text-white">Panduan iPhone / iOS (Safari)</h3>
                    </div>
                    <ol class="list-decimal list-inside space-y-2 text-slate-300">
                        <li>Buka aplikasi ini di **Safari** pada iPhone anda.</li>
                        <li>Tekan ikon <strong>Share (Kongsi)</strong> <i class="fa-solid fa-arrow-up-from-bracket text-sky-400"></i> di bahagian bawah skrin.</li>
                        <li>Cari dan tekan <strong>"Add to Home Screen" (Tambah ke Skrin Utama)</strong>.</li>
                        <li>Tekan **Add**. App sedia digunakan secara paparan skrin penuh!</li>
                    </ol>
                    <div class="bg-sky-950/40 border border-sky-500/30 p-2.5 rounded-xl text-sky-300 font-medium">
                        📱 Pelancaran dari Skrin Utama akan membuka app ini secara skrin penuh tanpa bar URL pelayar!
                    </div>
                </div>
            </div>
        </section>

    </main>

    <div id="widgetModal" class="fixed inset-0 bg-slate-950/85 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
        <div class="glass-panel border border-slate-700 rounded-3xl max-w-lg w-full p-6 shadow-2xl relative space-y-5">
            <button onclick="toggleWidgetPreviewModal()" class="absolute top-4 right-4 w-8 h-8 bg-slate-800 text-slate-400 hover:text-white rounded-full flex items-center justify-center transition">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="flex items-center space-x-3">
                <div class="p-3 rounded-2xl bg-emerald-500/20 text-emerald-400 text-xl">
                    <i class="fa-solid fa-shapes"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-white">Simulasi Widget Skrin Utama Telefon</h3>
                    <p class="text-xs text-slate-400">Gambaran rupa Widget Kalendar & Cuaca di telefon anda</p>
                </div>
            </div>

            <!-- Phone Frame Simulation -->
            <div class="bg-slate-900 border-4 border-slate-700 rounded-[2.5rem] p-4 shadow-inner space-y-4 relative overflow-hidden">
                <!-- Phone Status Bar -->
                <div class="flex justify-between items-center text-[10px] text-slate-400 px-2 pt-1">
                    <span class="font-bold text-white">09:41</span>
                    <div class="flex items-center space-x-1.5">
                        <i class="fa-solid fa-signal"></i>
                        <i class="fa-solid fa-wifi"></i>
                        <i class="fa-solid fa-battery-full"></i>
                    </div>
                </div>

                <!-- Simulated Widget Component -->
                <div class="weather-card-bg p-4 rounded-2xl shadow-xl border border-blue-400/40 text-white space-y-3">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center space-x-2">
                            <i class="fa-solid fa-cloud-sun-rain text-amber-300 text-xl"></i>
                            <div>
                                <p class="text-xs font-bold leading-none" id="widgetLoc">Kuala Lumpur</p>
                                <p class="text-[10px] text-blue-200">Hujan / Berawan</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-2xl font-black" id="widgetTemp">31°C</span>
